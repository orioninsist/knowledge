{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knowledge Productivity",
  "version": "0.1.0",
  "identifier": "dev.orioninsist.knowledge.productivity",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Knowledge Productivity",
        "url": "productivity/index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
