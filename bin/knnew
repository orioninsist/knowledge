#!/usr/bin/env bash

ROOT="/home/murat/Media/8-Document/Knowledge"

# Klasor sec
dir="$(
  find "$ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' |
  sort |
  fzf --prompt='Klasor > '
)"

[ -z "$dir" ] && exit 0
dir="$ROOT/$dir"

# Mevcut dosyalari goster.
# Mevcut dosya secilebilir veya yeni dosya adi yazilabilir.
result="$(
  find "$dir" -maxdepth 1 -type f -printf '%f\n' |
  sort |
  fzf \
    --print-query \
    --expect=enter \
    --prompt='Dosya > ' \
    --header='Mevcut dosyayi sec veya yeni dosya adi yaz'
)"

[ -z "$result" ] && exit 0

query="$(printf '%s\n' "$result" | sed -n '1p')"
selected="$(printf '%s\n' "$result" | sed -n '3p')"

if [ -n "$selected" ]; then
  name="$selected"
else
  name="$query"
fi

[ -z "$name" ] && exit 0

file="$dir/$name"

# Yoksa gercekten dosyayi olustur
if [ ! -e "$file" ]; then
  touch "$file"
fi

# Her durumda AstroNvim'de ac
exec env NVIM_APPNAME=astronvim nvim "$file"
