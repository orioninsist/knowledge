#!/usr/bin/env bash

ROOT="/home/murat/Media/8-Document/Knowledge"
cd "$ROOT" || exit 1

result="$(
  fd --type f --max-depth 1 --no-ignore --hidden \
    --exclude '.gitignore' \
    --exclude '.git' \
    . |
  sed 's|^\./||' |
  fzf \
    --prompt='File > ' \
    --disabled \
    --bind 'change:enable-search' \
    --print-query
)"

query="$(printf '%s\n' "$result" | head -n1)"
selected="$(printf '%s\n' "$result" | sed -n '2p')"

if [[ -n "$selected" ]]; then
  file="$selected"
elif [[ -n "$query" ]]; then
  file="$query"
else
  exit 0
fi

NVIM_APPNAME=astronvim nvim "$ROOT/$file"
