#!/usr/bin/env bash

SCRIPT_PATH="${BASH_SOURCE[0]}"

if command -v readlink >/dev/null 2>&1; then
    SCRIPT_PATH="$(
        readlink -f "$SCRIPT_PATH" 2>/dev/null ||
            printf '%s\n' "$SCRIPT_PATH"
    )"
fi

PROJECT="$(
    cd "$(dirname "$SCRIPT_PATH")/.." &&
        pwd
)"

# Personal-note Git history. Only paths inside WORKSPACE_ROOT are committed locally.
source "$PROJECT/scripts/notes-git.sh"

BUN="$(command -v bun || true)"

if [ -z "$BUN" ]; then
    echo
    echo "ERROR: bun is not available in PATH."
    exit 1
fi

RUNTIME_ENV="$PROJECT/.runtime/personal/runtime.env"

if [ ! -r "$RUNTIME_ENV" ]; then
    echo
    echo "ERROR: Runtime environment not found."
    echo
    echo "$RUNTIME_ENV"
    echo
    echo "Run the installer/runtime bootstrap first."
    exit 1
fi

ROOT="$(
    sed -n \
      's/^WORKSPACE_ROOT=//p' \
      "$RUNTIME_ENV" |
    head -1
)"

if [ -z "$ROOT" ]; then
    echo
    echo "ERROR: WORKSPACE_ROOT is missing from runtime.env."
    exit 1
fi

usage() {
    cat <<'HELP'

Knowledge CLI — local-first Markdown notes

Usage:
  kn --help
  kn <editor> [moc] [filename.md]
  kn glow <filename.md>
  kn mv <filename.md> <moc>
  kn rn <filename.md> <new-filename.md>
  kn link <source.md> [target.md]
  kn links <filename.md>
  kn backlinks <filename.md>
  kn broken-links
  kn doctor
  kn search [query...]
  kn docs [query...]

Open / create:
  kn nvim
      Choose a MOC, then choose an existing filename or type a new one.

  kn nvim inbox
      Use Inbox for a new note; an existing globally unique filename still
      opens from its real MOC.

  kn nvim inbox linux-notes
  kn code projects project-note.md
  kn zed areas german-notes.md
  kn hx resources reference.md

  Missing .md is added automatically. New notes are created only in the
  selected MOC. Existing notes are never silently moved.

Read:
  kn glow linux-notes.md
      Render one personal note in Glow.

Move / rename:
  kn mv linux-notes.md archives
  kn rn linux-notes.md linux-networking.md

  Move and rename require confirmation. Filenames remain globally unique.

Standard Markdown links:
  kn link docker.md
      Choose the target note globally with fzf. Knowledge finds its real MOC
      and prints a relative standard Markdown link.

  kn link docker.md linux-networking.md
      Generate the link directly for a known target.

  Example output:
      [Linux networking](../3-Resources/linux-networking.md)

  Wikilinks are not part of the note-link contract.

Relations:
  kn links linux-notes.md
      List notes linked from the note.

  kn backlinks linux-notes.md
      List notes linking to the note.

  kn broken-links
      Check standard Markdown note relations for missing targets.

Diagnostics:
  kn doctor
      Check workspace/runtime, MOCs, filename rules, global uniqueness,
      local-only notes Git, required tools, services, and broken relations.

Personal search:
  kn search
  kn search docker network
  kn search 'section:projects tag:linux status:todo'
  kn search 'title:"local first"'
  kn search 'file:systemd description:service alias:daemon'

  Inline filters:
      section: / folder:
      tag:
      status:
      file: / filename:
      title:
      description: / desc:
      alias:

  Results use SQLite FTS5 -> fzf -> normal Neovim.

Documentation search:
  kn docs
  kn docs systemd

  External documentation uses its separate FTS5 index and opens selected
  Markdown read-only with nvim -R.

Editors:
  code
  zed
  nvim
  hx

MOCs:
  inbox       -> 0-Inbox
  projects    -> 1-Projects
  areas       -> 2-Areas
  resources   -> 3-Resources
  archives    -> 4-Archives

Core rules:
  - Markdown is the source of truth.
  - Personal note filenames:
      ^[a-z0-9]+(?:-[a-z0-9]+)*\.md$
  - Filenames are globally unique across all five MOCs.
  - index.md and _index.md are reserved.
  - kn intentionally has no delete command; archive notes instead.
  - Personal notes use a separate local Git repository with no remote.
  - Search databases and runtime files are derived/rebuildable state.

Local services:
  Personal web:       http://127.0.0.1:1314/
  Productivity:       http://127.0.0.1:1314/productivity/
  Personal API:       http://127.0.0.1:8788/
  Documentation web:  http://127.0.0.1:1320/

HELP
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "help" ]; then
    usage
    exit 0
fi

find_note() {
    local name="$1"

    find \
        "$ROOT/0-Inbox" \
        "$ROOT/1-Projects" \
        "$ROOT/2-Areas" \
        "$ROOT/3-Resources" \
        "$ROOT/4-Archives" \
        -maxdepth 1 \
        -type f \
        -name "$name" \
        -print \
        -quit \
        2>/dev/null
}

normalize_note_name() {
    local name="$1"

    if [[ "$name" != *.md ]]; then
        name="$name.md"
    fi

    printf '%s\n' "$name"
}

require_fzf() {
    if ! command -v fzf >/dev/null 2>&1; then
        echo
        echo "ERROR: fzf is required."
        echo "Install: sudo dnf install fzf"
        return 1
    fi
}

require_glow() {
    if ! command -v glow >/dev/null 2>&1; then
        echo
        echo "ERROR: Glow is required."
        echo "Install Glow for Fedora, then retry."
        return 1
    fi
}

choose_from_list() {
    local prompt="$1"
    require_fzf || return 1
    fzf --prompt="$prompt> " --height=80% --layout=reverse --border
}

all_note_paths() {
    find \
        "$ROOT/0-Inbox" \
        "$ROOT/1-Projects" \
        "$ROOT/2-Areas" \
        "$ROOT/3-Resources" \
        "$ROOT/4-Archives" \
        -maxdepth 1 \
        -type f \
        -name '*.md' \
        -print \
        2>/dev/null | sort
}

all_note_names() {
    all_note_paths | sed 's|.*/||'
}

choose_moc() {
    printf '%s\n' \
        inbox \
        projects \
        areas \
        resources \
        archives \
        | choose_from_list "moc"
}

choose_note_path() {
    local prompt="${1:-note}"
    require_fzf || return 1
    require_glow || return 1

    all_note_paths |
        fzf \
            --prompt="$prompt> " \
            --height=90% \
            --layout=reverse \
            --border \
            --with-nth=-1 \
            --delimiter='/' \
            --preview 'glow -t {}' \
            --preview-window='right:60%:wrap'
}

validate_note_name() {
    local filename="$1"

    "$BUN" \
        "$PROJECT/scripts/validate-note-name.ts" \
        "$filename"
}

api_base() {
    local api_port

    api_port="$(
        sed -n \
            's/^API_PORT=//p' \
            "$RUNTIME_ENV" |
        head -1
    )"

    [ -n "$api_port" ] || return 1
    printf 'http://127.0.0.1:%s\n' "$api_port"
}

remember_note() {
    local filename="$1"
    local runtime_env="$PROJECT/.runtime/personal/runtime.env"
    local api_port

    [ -r "$runtime_env" ] || return 0

    api_port="$(
        sed -n \
            's/^API_PORT=//p' \
            "$runtime_env" |
        head -1
    )"

    [ -n "$api_port" ] || return 0

    curl \
        -fsS \
        -X POST \
        --get \
        --data-urlencode \
        "filename=$filename" \
        "http://127.0.0.1:${api_port}/api/last-note" \
        >/dev/null 2>&1 \
        || true
}

moc_dir() {
    case "$1" in
        inbox)
            printf '%s\n' "$ROOT/0-Inbox"
            ;;
        projects)
            printf '%s\n' "$ROOT/1-Projects"
            ;;
        areas)
            printf '%s\n' "$ROOT/2-Areas"
            ;;
        resources)
            printf '%s\n' "$ROOT/3-Resources"
            ;;
        archives)
            printf '%s\n' "$ROOT/4-Archives"
            ;;
        *)
            return 1
            ;;
    esac
}

path_moc() {
    case "$1" in
        "$ROOT/0-Inbox/"*)
            printf '%s\n' inbox
            ;;
        "$ROOT/1-Projects/"*)
            printf '%s\n' projects
            ;;
        "$ROOT/2-Areas/"*)
            printf '%s\n' areas
            ;;
        "$ROOT/3-Resources/"*)
            printf '%s\n' resources
            ;;
        "$ROOT/4-Archives/"*)
            printf '%s\n' archives
            ;;
        *)
            return 1
            ;;
    esac
}

markdown_title() {
    local file="$1"
    local title

    title="$(
        sed -n 's/^title:[[:space:]]*//p' "$file" |
        head -1 |
        sed -e 's/^["'\'' ]*//' -e 's/["'\'' ]*$//'
    )"

    if [ -z "$title" ]; then
        title="$(
            sed -n 's/^#[[:space:]]\+//p' "$file" |
            head -1
        )"
    fi

    if [ -z "$title" ]; then
        title="$(basename "$file" .md | tr '-' ' ')"
    fi

    printf '%s\n' "$title"
}

markdown_link_for() {
    local source="$1"
    local target="$2"
    local relative_path
    local title

    relative_path="$(
        realpath --relative-to="$(dirname "$source")" "$target"
    )" || return 1

    title="$(markdown_title "$target")"

    printf '[%s](%s)\n' "$title" "$relative_path"
}

#
# GLOW — READ NOTE
#

if [ "${1:-}" = "glow" ]; then
    if [ "$#" -ne 2 ]; then
        echo "Usage: kn glow <filename.md>"
        exit 1
    fi

    NAME="$(normalize_note_name "$2")"
    validate_note_name "$NAME" || exit 1

    FOUND="$(find_note "$NAME")"

    if [ -z "$FOUND" ]; then
        echo
        echo "ERROR: Markdown note not found."
        echo "$NAME"
        exit 1
    fi

    require_glow || exit 1
    exec glow -t "$FOUND"
fi

#
# MOVE BETWEEN MOCs
#


if [ "${1:-}" = "mv" ]; then
    if [ "$#" -ne 3 ]; then
        echo "Usage: kn mv <filename.md> <moc>"
        exit 1
    fi

    NAME="$2"
    TARGET_MOC="$3"

    validate_note_name "$NAME" || exit 1

    FOUND="$(find_note "$NAME")"

    if [ -z "$FOUND" ]; then
        echo
        echo "ERROR: Markdown note not found."
        echo
        echo "$NAME"
        exit 1
    fi

    CURRENT_MOC="$(path_moc "$FOUND")"

    TARGET_DIR="$(moc_dir "$TARGET_MOC")"

    if [ -z "$TARGET_DIR" ]; then
        echo
        echo "ERROR: Unknown MOC: $TARGET_MOC"
        echo
        echo "Allowed:"
        echo "  inbox"
        echo "  projects"
        echo "  areas"
        echo "  resources"
        echo "  archives"
        exit 1
    fi

    TARGET="$TARGET_DIR/$NAME"

    if [ "$CURRENT_MOC" = "$TARGET_MOC" ]; then
        echo
        echo "INFO: Note is already in $TARGET_MOC."
        echo
        echo "$FOUND"
        exit 0
    fi

    if [ -e "$TARGET" ]; then
        echo
        echo "ERROR: Target filename already exists."
        echo
        echo "$TARGET"
        exit 1
    fi

    echo
    echo "Move note"
    echo
    echo "File:  $NAME"
    echo "From:  $CURRENT_MOC"
    echo "To:    $TARGET_MOC"
    echo
    echo "$FOUND"
    echo "→"
    echo "$TARGET"
    echo
    printf "Move this note? [y/N] "

    read -r ANSWER

    case "$ANSWER" in
        y|Y|yes|YES|Yes)
            ;;
        *)
            echo
            echo "CANCELLED: Note was not moved."
            exit 0
            ;;
    esac

    OLD_RELATIVE="$(notes_git_relative_path "$FOUND")" || exit 1
    NEW_RELATIVE="$(notes_git_relative_path "$TARGET")" || exit 1

    # Remember whether the source is tracked. After the filesystem move,
    # remove only the old Git index entry; never delete a note file.
    SOURCE_TRACKED=0
    if git -C "$ROOT" ls-files --error-unmatch -- "$OLD_RELATIVE" >/dev/null 2>&1; then
        SOURCE_TRACKED=1
    fi

    mv -- "$FOUND" "$TARGET"

    if [ "$SOURCE_TRACKED" -eq 1 ]; then
        git -C "$ROOT" update-index --force-remove -- "$OLD_RELATIVE" || exit 1
    fi

    remember_note "$NAME"

    echo
    echo "PASS: Note moved."
    echo
    echo "$CURRENT_MOC → $TARGET_MOC"
    echo "$TARGET"

    notes_git_commit "MOVE" "$OLD_RELATIVE" "$NEW_RELATIVE"
    exit 0
fi

#
# RENAME
#
if [ "${1:-}" = "rn" ]; then
    if [ "$#" -ne 3 ]; then
        echo "Usage: kn rn <filename.md> <new-filename.md>"
        exit 1
    fi

    NAME="$2"
    validate_note_name "$NAME" || exit 1
    FOUND="$(find_note "$NAME")"

    if [ -z "$FOUND" ]; then
        echo
        echo "ERROR: Markdown note not found: $NAME"
        exit 1
    fi

    NEW_NAME="$(normalize_note_name "$3")"
    validate_note_name "$NEW_NAME" || exit 1

    if [ -n "$(find_note "$NEW_NAME")" ]; then
        echo
        echo "ERROR: Target filename already exists: $NEW_NAME"
        exit 1
    fi

    TARGET="$(dirname "$FOUND")/$NEW_NAME"

    echo
    echo "$FOUND"
    echo "→"
    echo "$TARGET"
    echo
    printf "Rename this note? [y/N] "
    read -r ANSWER

    case "$ANSWER" in
        y|Y|yes|YES|Yes) ;;
        *) echo "CANCELLED: Note was not renamed."; exit 0 ;;
    esac

    OLD_RELATIVE="$(notes_git_relative_path "$FOUND")" || exit 1
    NEW_RELATIVE="$(notes_git_relative_path "$TARGET")" || exit 1

    SOURCE_TRACKED=0
    if git -C "$ROOT" ls-files --error-unmatch -- "$OLD_RELATIVE" >/dev/null 2>&1; then
        SOURCE_TRACKED=1
    fi

    mv -- "$FOUND" "$TARGET"

    if [ "$SOURCE_TRACKED" -eq 1 ]; then
        git -C "$ROOT" update-index --force-remove -- "$OLD_RELATIVE" || exit 1
    fi

    remember_note "$NEW_NAME"
    notes_git_commit "RENAME" "$OLD_RELATIVE" "$NEW_RELATIVE"
    exit 0
fi

#
# STANDARD MARKDOWN LINK
#
if [ "${1:-}" = "link" ]; then
    if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
        echo "Usage: kn link <source.md> [target.md]"
        exit 1
    fi

    SOURCE_NAME="$(normalize_note_name "$2")"
    validate_note_name "$SOURCE_NAME" || exit 1
    SOURCE_PATH="$(find_note "$SOURCE_NAME")"

    if [ -z "$SOURCE_PATH" ]; then
        echo
        echo "ERROR: Source Markdown note not found: $SOURCE_NAME"
        exit 1
    fi

    if [ "$#" -eq 3 ]; then
        TARGET_NAME="$(normalize_note_name "$3")"
        validate_note_name "$TARGET_NAME" || exit 1
        TARGET_PATH="$(find_note "$TARGET_NAME")"
    else
        TARGET_PATH="$(choose_note_path "link")" || exit 0
        [ -n "$TARGET_PATH" ] || exit 0
    fi

    if [ -z "$TARGET_PATH" ] || [ ! -f "$TARGET_PATH" ]; then
        echo
        echo "ERROR: Target Markdown note not found."
        exit 1
    fi

    if [ "$SOURCE_PATH" = "$TARGET_PATH" ]; then
        echo
        echo "ERROR: Source and target note are the same."
        exit 1
    fi

    markdown_link_for "$SOURCE_PATH" "$TARGET_PATH"
    exit 0
fi

#
# NOTE RELATIONS
#
if [ "${1:-}" = "links" ] || [ "${1:-}" = "backlinks" ]; then
    if [ "$#" -ne 2 ]; then
        echo "Usage: kn $1 <filename.md>"
        exit 1
    fi
    NAME="$(normalize_note_name "$2")"
    validate_note_name "$NAME" || exit 1
    cd "$PROJECT" || exit 1
    exec "$BUN" scripts/note-relations.ts "$1" "$NAME"
fi

if [ "${1:-}" = "broken-links" ]; then
    [ "$#" -eq 1 ] || { echo "Usage: kn broken-links"; exit 1; }
    cd "$PROJECT" || exit 1
    exec "$BUN" scripts/note-relations.ts broken
fi

#
# DIAGNOSTICS
#
if [ "${1:-}" = "doctor" ]; then
    [ "$#" -eq 1 ] || { echo "Usage: kn doctor"; exit 1; }
    cd "$PROJECT" || exit 1
    exec "$BUN" scripts/doctor.ts
fi

#
# PERSONAL SEARCH
#
if [ "${1:-}" = "search" ] || [ "${1:-}" = "docs" ]; then
    require_fzf || exit 1

    MODE="${1}"
    QUERY="${*:2}"
    SEARCH_HELPER="$PROJECT/scripts/kn-terminal-search.ts"

    if [ "$MODE" = "search" ]; then
        SEARCH_MODE="personal"
        SEARCH_ROOT="$ROOT"
        SEARCH_PROMPT="search> "
    else
        SEARCH_MODE="docs"
        SEARCH_ROOT="${KNOWLEDGE_DOCS_ROOT:-/home/murat/Media/5-Documentation}"
        SEARCH_PROMPT="docs> "
    fi

    export KN_SEARCH_ROOT="$SEARCH_ROOT"

    SELECTED="$(
        fzf \
            --disabled \
            --prompt="$SEARCH_PROMPT" \
            --query="$QUERY" \
            --height=90% \
            --layout=reverse \
            --border \
            --bind "start:reload($BUN $SEARCH_HELPER $SEARCH_MODE {q})" \
            --bind "change:reload($BUN $SEARCH_HELPER $SEARCH_MODE {q})" \
            --preview 'sed -n "1,160p" "$KN_SEARCH_ROOT"/{}' \
            --preview-window='right:60%:wrap' \
            </dev/null
    )" || exit 0

    [ -n "$SELECTED" ] || exit 0

    TARGET="$SEARCH_ROOT/$SELECTED"

    case "$TARGET" in
        "$SEARCH_ROOT"/*.md)
            ;;
        *)
            echo "ERROR: Selected path escaped its search root."
            exit 1
            ;;
    esac

    if [ "$MODE" = "docs" ]; then
        exec nvim -R "$TARGET"
    fi

    exec nvim "$TARGET"
fi

#
# DOCUMENTATION SEARCH is intentionally handled above with the same
# bounded FTS5/fzf flow as personal search. Documentation opens read-only.
#

#
# NORMAL OPEN / CREATE
#
# Flow:
#   kn <editor>
#     1. choose one of the five MOCs
#     2. choose/type a filename from the global Markdown pool
#     3. existing note opens from its real MOC
#     4. new note is created only in the selected MOC
#
if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
    usage
    exit 1
fi

EDITOR_CMD="$1"
MOC="${2:-}"
NAME="${3:-}"

if ! command -v "$EDITOR_CMD" >/dev/null 2>&1; then
    echo
    echo "ERROR: Editor command not found:"
    echo "$EDITOR_CMD"
    exit 1
fi

if [ -z "$MOC" ]; then
    MOC="$(choose_moc)" || exit 0
fi

if [ -z "$MOC" ]; then
    exit 0
fi

TARGET_DIR="$(moc_dir "$MOC")"

if [ -z "$TARGET_DIR" ]; then
    echo
    echo "ERROR: Unknown MOC: $MOC"
    exit 1
fi

if [ -z "$NAME" ]; then
    require_fzf || exit 1

    FZF_OUTPUT="$(
        all_note_names |
        fzf \
            --prompt='filename> ' \
            --height=90% \
            --layout=reverse \
            --border \
            --print-query
    )"
    FZF_STATUS=$?

    # fzf --print-query prints the typed query first and the selected row second.
    # If a row was selected, use it. Otherwise use the typed query so a new note
    # can be created without leaving the picker.
    if [ -n "$FZF_OUTPUT" ]; then
        NAME="$(printf '%s\n' "$FZF_OUTPUT" | tail -1)"
    elif [ "$FZF_STATUS" -ne 0 ]; then
        exit 0
    fi
fi

if [ -z "$NAME" ]; then
    exit 0
fi

NAME="$(normalize_note_name "$NAME")"
validate_note_name "$NAME" || exit 1

run_editor() {
    local file="$1"

    case "$EDITOR_CMD" in
        code|code-insiders|codium)
            "$EDITOR_CMD" --wait "$file"
            ;;
        *)
            "$EDITOR_CMD" "$file"
            ;;
    esac
}

# Filename is globally unique. The selected MOC never relocates an existing note.
FOUND="$(find_note "$NAME")"

if [ -n "$FOUND" ]; then
    remember_note "$NAME"
    RELATIVE="$(notes_git_relative_path "$FOUND")" || exit 1
    run_editor "$FOUND" || exit $?
    notes_git_commit "EDIT" "$RELATIVE"
    exit 0
fi

# Only a genuinely new filename uses the selected MOC.
cd "$PROJECT" || exit 1
"$BUN" scripts/new-note.ts "$MOC" "$NAME" || exit 1

remember_note "$NAME"
NEW_PATH="$TARGET_DIR/$NAME"
RELATIVE="$(notes_git_relative_path "$NEW_PATH")" || exit 1

run_editor "$NEW_PATH" || exit $?
notes_git_commit "CREATE" "$RELATIVE"
exit 0
