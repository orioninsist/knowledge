#!/usr/bin/env bash

SCRIPT_PATH="${BASH_SOURCE[0]}"

if command -v readlink >/dev/null 2>&1; then
    SCRIPT_PATH="$(
        readlink -f "$SCRIPT_PATH" 2>/dev/null ||
            printf '%s\n' "$SCRIPT_PATH"
    )"
fi

PROJECT="$(
    cd "$(dirname "$SCRIPT_PATH")/.." &&
        pwd
)"

# Personal-note Git history. Only paths inside WORKSPACE_ROOT are committed locally.
source "$PROJECT/scripts/notes-git.sh"

BUN="$(command -v bun || true)"

if [ -z "$BUN" ]; then
    echo
    echo "ERROR: bun is not available in PATH."
    exit 1
fi

RUNTIME_ENV="$PROJECT/.runtime/personal/runtime.env"

if [ ! -r "$RUNTIME_ENV" ]; then
    echo
    echo "ERROR: Runtime environment not found."
    echo
    echo "$RUNTIME_ENV"
    echo
    echo "Run the installer/runtime bootstrap first."
    exit 1
fi

ROOT="$(
    sed -n \
      's/^WORKSPACE_ROOT=//p' \
      "$RUNTIME_ENV" |
    head -1
)"

if [ -z "$ROOT" ]; then
    echo
    echo "ERROR: WORKSPACE_ROOT is missing from runtime.env."
    exit 1
fi

usage() {
    cat <<'HELP'

Usage:

  Read:
    kn glow <filename.md>

  Open/create:
    kn <editor> <moc> <filename.md>
    kn <editor> <moc>
    kn <editor>

  Move:
    kn mv <filename.md> [moc]

  Rename:
    kn rn <filename.md> [new-filename.md]

  Search:
    kn search [words...]

  Documentation:
    kn docs [words...]

Examples:

    kn glow linux-notes.md

    kn code inbox linux-notes.md
    kn zed projects project-note.md
    kn hx resources linux-notes.md
    kn nvim areas german-notes.md
    kn nvim inbox linux-notes
    kn nvim

    kn mv linux-notes.md archives
    kn rn linux-notes.md linux-networking.md
    kn search docker network
    kn docs systemd

Editors:

    code
    zed
    nvim
    hx

MOC:

    inbox
    projects
    areas
    resources
    archives

HELP
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "help" ]; then
    usage
    exit 0
fi

find_note() {
    local name="$1"

    find \
        "$ROOT/0-Inbox" \
        "$ROOT/1-Projects" \
        "$ROOT/2-Areas" \
        "$ROOT/3-Resources" \
        "$ROOT/4-Archives" \
        -maxdepth 1 \
        -type f \
        -name "$name" \
        -print \
        -quit \
        2>/dev/null
}

normalize_note_name() {
    local name="$1"

    if [[ "$name" != *.md ]]; then
        name="$name.md"
    fi

    printf '%s\n' "$name"
}

require_fzf() {
    if ! command -v fzf >/dev/null 2>&1; then
        echo
        echo "ERROR: fzf is required."
        echo "Install: sudo dnf install fzf"
        return 1
    fi
}

require_glow() {
    if ! command -v glow >/dev/null 2>&1; then
        echo
        echo "ERROR: Glow is required."
        echo "Install Glow for Fedora, then retry."
        return 1
    fi
}

choose_from_list() {
    local prompt="$1"
    require_fzf || return 1
    fzf --prompt="$prompt> " --height=80% --layout=reverse --border
}

all_note_paths() {
    find \
        "$ROOT/0-Inbox" \
        "$ROOT/1-Projects" \
        "$ROOT/2-Areas" \
        "$ROOT/3-Resources" \
        "$ROOT/4-Archives" \
        -maxdepth 1 \
        -type f \
        -name '*.md' \
        -print \
        2>/dev/null | sort
}

all_note_names() {
    all_note_paths | sed 's|.*/||'
}

choose_moc() {
    printf '%s\n' \
        inbox \
        projects \
        areas \
        resources \
        archives \
        | choose_from_list "moc"
}

choose_note_path() {
    local prompt="${1:-note}"
    require_fzf || return 1
    require_glow || return 1

    all_note_paths |
        fzf \
            --prompt="$prompt> " \
            --height=90% \
            --layout=reverse \
            --border \
            --with-nth=-1 \
            --delimiter='/' \
            --preview 'glow -t {}' \
            --preview-window='right:60%:wrap'
}

validate_note_name() {
    local filename="$1"

    "$BUN" \
        "$PROJECT/scripts/validate-note-name.ts" \
        "$filename"
}

api_base() {
    local api_port

    api_port="$(
        sed -n \
            's/^API_PORT=//p' \
            "$RUNTIME_ENV" |
        head -1
    )"

    [ -n "$api_port" ] || return 1
    printf 'http://127.0.0.1:%s\n' "$api_port"
}

remember_note() {
    local filename="$1"
    local runtime_env="$PROJECT/.runtime/personal/runtime.env"
    local api_port

    [ -r "$runtime_env" ] || return 0

    api_port="$(
        sed -n \
            's/^API_PORT=//p' \
            "$runtime_env" |
        head -1
    )"

    [ -n "$api_port" ] || return 0

    curl \
        -fsS \
        -X POST \
        --get \
        --data-urlencode \
        "filename=$filename" \
        "http://127.0.0.1:${api_port}/api/last-note" \
        >/dev/null 2>&1 \
        || true
}

moc_dir() {
    case "$1" in
        inbox)
            printf '%s\n' "$ROOT/0-Inbox"
            ;;
        projects)
            printf '%s\n' "$ROOT/1-Projects"
            ;;
        areas)
            printf '%s\n' "$ROOT/2-Areas"
            ;;
        resources)
            printf '%s\n' "$ROOT/3-Resources"
            ;;
        archives)
            printf '%s\n' "$ROOT/4-Archives"
            ;;
        *)
            return 1
            ;;
    esac
}

path_moc() {
    case "$1" in
        "$ROOT/0-Inbox/"*)
            printf '%s\n' inbox
            ;;
        "$ROOT/1-Projects/"*)
            printf '%s\n' projects
            ;;
        "$ROOT/2-Areas/"*)
            printf '%s\n' areas
            ;;
        "$ROOT/3-Resources/"*)
            printf '%s\n' resources
            ;;
        "$ROOT/4-Archives/"*)
            printf '%s\n' archives
            ;;
        *)
            return 1
            ;;
    esac
}

#
# GLOW — READ NOTE
#

if [ "${1:-}" = "glow" ]; then
    if [ "$#" -gt 2 ]; then
        echo "Usage: kn glow [filename.md]"
        exit 1
    fi

    NAME="${2:-}"

    if [ -z "$NAME" ]; then
        FOUND="$(choose_note_path "glow")" || exit 0
        NAME="$(basename "$FOUND")"
    fi

    validate_note_name "$NAME" || exit 1

    FOUND="${FOUND:-$(find_note "$NAME")}"

    if [ -z "$FOUND" ]; then
        echo
        echo "ERROR: Markdown note not found."
        echo
        echo "$NAME"
        exit 1
    fi

    if ! command -v glow >/dev/null 2>&1; then
        echo
        echo "ERROR: Glow is not installed."
        echo "Install Glow for Fedora, then retry."
        exit 1
    fi

    remember_note "$NAME"

    exec glow -t "$FOUND"
fi

#
# DELETE IS DISABLED
#
if [ "${1:-}" = "rm" ]; then
    echo
    echo "ERROR: Note deletion is disabled by design."
    echo "Use 'kn mv <filename.md> archives' instead."
    exit 1
fi

#
# MOVE BETWEEN MOCs
#


if [ "${1:-}" = "mv" ]; then
    if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
        echo "Usage: kn mv <filename.md> [moc]"
        exit 1
    fi

    NAME="$2"
    TARGET_MOC="${3:-}"

    validate_note_name "$NAME" || exit 1

    FOUND="$(find_note "$NAME")"

    if [ -z "$FOUND" ]; then
        echo
        echo "ERROR: Markdown note not found."
        echo
        echo "$NAME"
        exit 1
    fi

    CURRENT_MOC="$(path_moc "$FOUND")"

    if [ -z "$TARGET_MOC" ]; then
        TARGET_MOC="$(
            printf '%s\n' inbox projects areas resources archives |
            grep -vx "$CURRENT_MOC" |
            choose_from_list "moc"
        )" || exit 0
    fi

    TARGET_DIR="$(moc_dir "$TARGET_MOC")"

    if [ -z "$TARGET_DIR" ]; then
        echo
        echo "ERROR: Unknown MOC: $TARGET_MOC"
        echo
        echo "Allowed:"
        echo "  inbox"
        echo "  projects"
        echo "  areas"
        echo "  resources"
        echo "  archives"
        exit 1
    fi

    TARGET="$TARGET_DIR/$NAME"

    if [ "$CURRENT_MOC" = "$TARGET_MOC" ]; then
        echo
        echo "INFO: Note is already in $TARGET_MOC."
        echo
        echo "$FOUND"
        exit 0
    fi

    if [ -e "$TARGET" ]; then
        echo
        echo "ERROR: Target filename already exists."
        echo
        echo "$TARGET"
        exit 1
    fi

    echo
    echo "Move note"
    echo
    echo "File:  $NAME"
    echo "From:  $CURRENT_MOC"
    echo "To:    $TARGET_MOC"
    echo
    echo "$FOUND"
    echo "→"
    echo "$TARGET"
    echo
    printf "Move this note? [y/N] "

    read -r ANSWER

    case "$ANSWER" in
        y|Y|yes|YES|Yes)
            ;;
        *)
            echo
            echo "CANCELLED: Note was not moved."
            exit 0
            ;;
    esac

    OLD_RELATIVE="$(notes_git_relative_path "$FOUND")" || exit 1
    NEW_RELATIVE="$(notes_git_relative_path "$TARGET")" || exit 1

    mv -- "$FOUND" "$TARGET"

    remember_note "$NAME"

    echo
    echo "PASS: Note moved."
    echo
    echo "$CURRENT_MOC → $TARGET_MOC"
    echo "$TARGET"

    notes_git_commit "MOVE" "$OLD_RELATIVE" "$NEW_RELATIVE"
    exit 0
fi

#
# RENAME
#
if [ "${1:-}" = "rn" ]; then
    if [ "$#" -lt 2 ] || [ "$#" -gt 3 ]; then
        echo "Usage: kn rn <filename.md> [new-filename.md]"
        exit 1
    fi

    NAME="$2"
    validate_note_name "$NAME" || exit 1
    FOUND="$(find_note "$NAME")"

    if [ -z "$FOUND" ]; then
        echo
        echo "ERROR: Markdown note not found: $NAME"
        exit 1
    fi

    NEW_NAME="${3:-}"
    if [ -z "$NEW_NAME" ]; then
        printf 'new filename> '
        read -r NEW_NAME
    fi

    NEW_NAME="$(normalize_note_name "$NEW_NAME")"
    validate_note_name "$NEW_NAME" || exit 1

    if [ -n "$(find_note "$NEW_NAME")" ]; then
        echo
        echo "ERROR: Target filename already exists: $NEW_NAME"
        exit 1
    fi

    TARGET="$(dirname "$FOUND")/$NEW_NAME"

    echo
    echo "$FOUND"
    echo "→"
    echo "$TARGET"
    echo
    printf "Rename this note? [y/N] "
    read -r ANSWER

    case "$ANSWER" in
        y|Y|yes|YES|Yes) ;;
        *) echo "CANCELLED: Note was not renamed."; exit 0 ;;
    esac

    OLD_RELATIVE="$(notes_git_relative_path "$FOUND")" || exit 1
    NEW_RELATIVE="$(notes_git_relative_path "$TARGET")" || exit 1

    mv -- "$FOUND" "$TARGET"
    remember_note "$NEW_NAME"
    notes_git_commit "RENAME" "$OLD_RELATIVE" "$NEW_RELATIVE"
    exit 0
fi

#
# PERSONAL SEARCH
#
if [ "${1:-}" = "search" ]; then
    require_fzf || exit 1
    require_glow || exit 1

    QUERY="${*:2}"
    API="$(api_base)" || {
        echo "ERROR: Personal search API is not available."
        exit 1
    }

    RESULTS="$(
        curl -fsS --get --data-urlencode "q=$QUERY" "$API/api/search" 2>/dev/null |
        "$BUN" -e '
          const data = await Bun.stdin.json();
          for (const r of data.results ?? []) {
            const section = String(r.section ?? "");
            const folder = {inbox:"0-Inbox",projects:"1-Projects",areas:"2-Areas",resources:"3-Resources",archives:"4-Archives"}[section];
            if (!folder || !r.url) continue;
            const stem = decodeURIComponent(String(r.url).split("/").filter(Boolean).at(-1) ?? "");
            if (!stem) continue;
            console.log(folder + "/" + stem + ".md");
          }
        '
    )" || exit 1

    if [ -z "$RESULTS" ]; then
        echo "No matching notes."
        exit 0
    fi

    SELECTED="$(
        printf '%s\n' "$RESULTS" |
        fzf \
            --prompt='search> ' \
            --query="$QUERY" \
            --height=90% \
            --layout=reverse \
            --border \
            --with-nth=2 \
            --delimiter='/' \
            --preview 'glow -t "'"$ROOT"'"/{}' \
            --preview-window='right:60%:wrap'
    )" || exit 0

    exec glow -t "$ROOT/$SELECTED"
fi

#
# DOCUMENTATION SEARCH (READ-ONLY)
#
if [ "${1:-}" = "docs" ]; then
    require_fzf || exit 1
    require_glow || exit 1

    DOCS_ROOT="${KNOWLEDGE_DOCS_ROOT:-/home/murat/Media/5-Documentation}"
    QUERY="${*:2}"

    if [ -z "$QUERY" ]; then
        RESULTS="$(find "$DOCS_ROOT" -type f -name '*.md' -print 2>/dev/null)"
    else
        RESULTS="$(
            curl -fsS --get --data-urlencode "q=$QUERY" "http://127.0.0.1:1320/api/search" 2>/dev/null |
            "$BUN" -e '
              const data = await Bun.stdin.json();
              for (const r of data.results ?? []) {
                const u = String(r.url ?? "");
                const m = u.match(/[?&]path=([^&]+)/);
                if (!m) continue;
                console.log(decodeURIComponent(m[1]));
              }
            '
        )" || exit 1
        RESULTS="$(
            printf '%s\n' "$RESULTS" |
            while IFS= read -r rel; do
                [ -n "$rel" ] && printf '%s/%s\n' "$DOCS_ROOT" "$rel"
            done
        )"
    fi

    if [ -z "$RESULTS" ]; then
        echo "No matching documentation."
        exit 0
    fi

    SELECTED="$(
        printf '%s\n' "$RESULTS" |
        fzf \
            --prompt='docs> ' \
            --height=90% \
            --layout=reverse \
            --border \
            --preview 'glow -t {}' \
            --preview-window='right:60%:wrap'
    )" || exit 0

    exec glow -t "$SELECTED"
fi

#
# NORMAL OPEN / CREATE
#
# Flow:
#   kn <editor>
#     1. choose one of the five MOCs
#     2. choose/type a filename from the global Markdown pool
#     3. existing note opens from its real MOC
#     4. new note is created only in the selected MOC
#
if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
    usage
    exit 1
fi

EDITOR_CMD="$1"
MOC="${2:-}"
NAME="${3:-}"

if ! command -v "$EDITOR_CMD" >/dev/null 2>&1; then
    echo
    echo "ERROR: Editor command not found:"
    echo "$EDITOR_CMD"
    exit 1
fi

if [ -z "$MOC" ]; then
    MOC="$(choose_moc)" || exit 0
fi

if [ -z "$MOC" ]; then
    exit 0
fi

TARGET_DIR="$(moc_dir "$MOC")"

if [ -z "$TARGET_DIR" ]; then
    echo
    echo "ERROR: Unknown MOC: $MOC"
    exit 1
fi

if [ -z "$NAME" ]; then
    require_fzf || exit 1

    FZF_OUTPUT="$(
        all_note_names |
        fzf \
            --prompt='filename> ' \
            --height=90% \
            --layout=reverse \
            --border \
            --print-query
    )"
    FZF_STATUS=$?

    # fzf --print-query prints the typed query first and the selected row second.
    # If a row was selected, use it. Otherwise use the typed query so a new note
    # can be created without leaving the picker.
    if [ -n "$FZF_OUTPUT" ]; then
        NAME="$(printf '%s\n' "$FZF_OUTPUT" | tail -1)"
    elif [ "$FZF_STATUS" -ne 0 ]; then
        exit 0
    fi
fi

if [ -z "$NAME" ]; then
    exit 0
fi

NAME="$(normalize_note_name "$NAME")"
validate_note_name "$NAME" || exit 1

run_editor() {
    local file="$1"

    case "$EDITOR_CMD" in
        code|code-insiders|codium)
            "$EDITOR_CMD" --wait "$file"
            ;;
        *)
            "$EDITOR_CMD" "$file"
            ;;
    esac
}

# Filename is globally unique. The selected MOC never relocates an existing note.
FOUND="$(find_note "$NAME")"

if [ -n "$FOUND" ]; then
    remember_note "$NAME"
    RELATIVE="$(notes_git_relative_path "$FOUND")" || exit 1
    run_editor "$FOUND" || exit $?
    notes_git_commit "EDIT" "$RELATIVE"
    exit 0
fi

# Only a genuinely new filename uses the selected MOC.
cd "$PROJECT" || exit 1
"$BUN" scripts/new-note.ts "$MOC" "$NAME" || exit 1

remember_note "$NAME"
NEW_PATH="$TARGET_DIR/$NAME"
RELATIVE="$(notes_git_relative_path "$NEW_PATH")" || exit 1

run_editor "$NEW_PATH" || exit $?
notes_git_commit "CREATE" "$RELATIVE"
exit 0
