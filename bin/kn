#!/usr/bin/env bash

PROJECT="$(
    cd "$(dirname "${BASH_SOURCE[0]}")/.." &&
        pwd
)"

# Local-only version history for personal Markdown notes.
# This repository must never have a remote.
source "$PROJECT/scripts/notes-git.sh"

BUN="$(command -v bun || true)"

if [ -z "$BUN" ]; then
    echo
    echo "ERROR: bun is not available in PATH."
    exit 1
fi

RUNTIME_ENV="$PROJECT/.runtime/personal/runtime.env"

if [ ! -r "$RUNTIME_ENV" ]; then
    echo
    echo "ERROR: Runtime environment not found."
    echo
    echo "$RUNTIME_ENV"
    echo
    echo "Run the installer/runtime bootstrap first."
    exit 1
fi

ROOT="$(
    sed -n \
      's/^WORKSPACE_ROOT=//p' \
      "$RUNTIME_ENV" |
    head -1
)"

if [ -z "$ROOT" ]; then
    echo
    echo "ERROR: WORKSPACE_ROOT is missing from runtime.env."
    exit 1
fi

usage() {
    cat <<'HELP'

Usage:

  Read:
    kn glow <filename.md>

  Open/create:
    kn <editor> <moc> <filename.md>

  Move:
    kn mv <filename.md> <moc>

  Delete:
    kn rm <filename.md>

Examples:

    kn glow linux-notes.md

    kn code inbox linux-notes.md
    kn zed projects project-note.md
    kn hx resources linux-notes.md
    kn nvim areas german-notes.md

    kn mv linux-notes.md archives
    kn rm linux-notes.md

MOC:

    inbox
    projects
    areas
    resources
    archives

HELP
}

find_note() {
    local name="$1"

    find \
        "$ROOT/0-Inbox" \
        "$ROOT/1-Projects" \
        "$ROOT/2-Areas" \
        "$ROOT/3-Resources" \
        "$ROOT/4-Archives" \
        -maxdepth 1 \
        -type f \
        -name "$name" \
        -print \
        -quit \
        2>/dev/null
}

normalize_note_name() {
    local name="$1"

    if [[ "$name" != *.md ]]; then
        name="$name.md"
    fi

    printf '%s\n' "$name"
}

choose_from_list() {
    local prompt="$1"

    if command -v fzf >/dev/null 2>&1; then
        fzf --prompt="$prompt> "
        return
    fi

    sed -n '1p'
}

choose_moc() {
    printf '%s\n' \
        inbox \
        projects \
        areas \
        resources \
        archives \
        | choose_from_list "moc"
}

choose_note_name() {
    local target_dir="$1"
    local selected=""

    selected="$(
        find "$target_dir" \
            -maxdepth 1 \
            -type f \
            -name '*.md' \
            -printf '%f\n' \
            2>/dev/null \
            | sort \
            | choose_from_list "filename"
    )" || true

    if [ -n "$selected" ]; then
        printf '%s\n' "$selected"
        return
    fi

    printf 'filename.md> ' >&2
    read -r selected
    printf '%s\n' "$selected"
}

validate_note_name() {
    local filename="$1"

    "$BUN" \
        "$PROJECT/scripts/validate-note-name.ts" \
        "$filename"
}

remember_note() {
    local filename="$1"
    local runtime_env="$PROJECT/.runtime/personal/runtime.env"
    local api_port

    [ -r "$runtime_env" ] || return 0

    api_port="$(
        sed -n \
            's/^API_PORT=//p' \
            "$runtime_env" |
        head -1
    )"

    [ -n "$api_port" ] || return 0

    curl \
        -fsS \
        -X POST \
        --get \
        --data-urlencode \
        "filename=$filename" \
        "http://127.0.0.1:${api_port}/api/last-note" \
        >/dev/null 2>&1 \
        || true
}

moc_dir() {
    case "$1" in
        inbox)
            printf '%s\n' "$ROOT/0-Inbox"
            ;;
        projects)
            printf '%s\n' "$ROOT/1-Projects"
            ;;
        areas)
            printf '%s\n' "$ROOT/2-Areas"
            ;;
        resources)
            printf '%s\n' "$ROOT/3-Resources"
            ;;
        archives)
            printf '%s\n' "$ROOT/4-Archives"
            ;;
        *)
            return 1
            ;;
    esac
}

path_moc() {
    case "$1" in
        "$ROOT/0-Inbox/"*)
            printf '%s\n' inbox
            ;;
        "$ROOT/1-Projects/"*)
            printf '%s\n' projects
            ;;
        "$ROOT/2-Areas/"*)
            printf '%s\n' areas
            ;;
        "$ROOT/3-Resources/"*)
            printf '%s\n' resources
            ;;
        "$ROOT/4-Archives/"*)
            printf '%s\n' archives
            ;;
        *)
            return 1
            ;;
    esac
}

#
# GLOW — READ NOTE
#

if [ "${1:-}" = "glow" ]; then
    if [ "$#" -ne 2 ]; then
        echo "Usage: kn glow <filename.md>"
        exit 1
    fi

    NAME="$2"

    validate_note_name "$NAME" || exit 1

    FOUND="$(find_note "$NAME")"

    if [ -z "$FOUND" ]; then
        echo
        echo "ERROR: Markdown note not found."
        echo
        echo "$NAME"
        exit 1
    fi

    if ! command -v glow >/dev/null 2>&1; then
        echo
        echo "ERROR: Glow is not installed."
        echo "Install: sudo pacman -S glow"
        exit 1
    fi

    if ! command -v zeditor >/dev/null 2>&1; then
        echo
        echo "ERROR: Zed CLI (zeditor) is not available."
        exit 1
    fi

    remember_note "$NAME"

    export EDITOR="zeditor --wait"
    export VISUAL="zeditor --wait"

    exec glow -t "$FOUND"
fi

#
# DELETE
#

if [ "${1:-}" = "rm" ]; then
    if [ "$#" -ne 2 ]; then
        echo "Usage: kn rm <filename.md>"
        exit 1
    fi

    NAME="$2"

    validate_note_name "$NAME" || exit 1

    FOUND="$(find_note "$NAME")"

    if [ -z "$FOUND" ]; then
        echo
        echo "ERROR: Markdown note not found."
        echo
        echo "$NAME"
        exit 1
    fi

    if ! command -v nvim >/dev/null 2>&1; then
        echo
        echo "ERROR: Neovim (nvim) is not available."
        echo "Note was not deleted."
        exit 1
    fi

    echo
    echo "Review note before deletion."
    echo "Exit Neovim with :q to continue to the delete confirmation."
    echo

    if ! nvim -R "$FOUND"; then
        echo
        echo "CANCELLED: Neovim did not exit successfully."
        echo "Note was not deleted."
        exit 1
    fi

    MOC="$(path_moc "$FOUND")"

    echo
    echo "Delete note"
    echo
    echo "File:  $NAME"
    echo "MOC:   $MOC"
    echo
    echo "$FOUND"
    echo
    printf "Delete this note? [y/N] "

    read -r ANSWER

    case "$ANSWER" in
        y|Y|yes|YES|Yes)
            ;;
        *)
            echo
            echo "CANCELLED: Note was not deleted."
            exit 0
            ;;
    esac

    RELATIVE="$(notes_git_relative_path "$FOUND")" || exit 1

    rm -- "$FOUND"

    echo
    echo "PASS: Note deleted."

    notes_git_commit "DELETE" "$RELATIVE"
    exit 0
fi

#
# MOVE BETWEEN MOCs
#

if [ "${1:-}" = "mv" ]; then
    if [ "$#" -ne 3 ]; then
        echo "Usage: kn mv <filename.md> <moc>"
        exit 1
    fi

    NAME="$2"
    TARGET_MOC="$3"

    validate_note_name "$NAME" || exit 1

    FOUND="$(find_note "$NAME")"

    if [ -z "$FOUND" ]; then
        echo
        echo "ERROR: Markdown note not found."
        echo
        echo "$NAME"
        exit 1
    fi

    TARGET_DIR="$(moc_dir "$TARGET_MOC")"

    if [ -z "$TARGET_DIR" ]; then
        echo
        echo "ERROR: Unknown MOC: $TARGET_MOC"
        echo
        echo "Allowed:"
        echo "  inbox"
        echo "  projects"
        echo "  areas"
        echo "  resources"
        echo "  archives"
        exit 1
    fi

    CURRENT_MOC="$(path_moc "$FOUND")"
    TARGET="$TARGET_DIR/$NAME"

    if [ "$CURRENT_MOC" = "$TARGET_MOC" ]; then
        echo
        echo "INFO: Note is already in $TARGET_MOC."
        echo
        echo "$FOUND"
        exit 0
    fi

    if [ -e "$TARGET" ]; then
        echo
        echo "ERROR: Target filename already exists."
        echo
        echo "$TARGET"
        exit 1
    fi

    echo
    echo "Move note"
    echo
    echo "File:  $NAME"
    echo "From:  $CURRENT_MOC"
    echo "To:    $TARGET_MOC"
    echo
    echo "$FOUND"
    echo "→"
    echo "$TARGET"
    echo
    printf "Move this note? [y/N] "

    read -r ANSWER

    case "$ANSWER" in
        y|Y|yes|YES|Yes)
            ;;
        *)
            echo
            echo "CANCELLED: Note was not moved."
            exit 0
            ;;
    esac

    OLD_RELATIVE="$(notes_git_relative_path "$FOUND")" || exit 1
    NEW_RELATIVE="$(notes_git_relative_path "$TARGET")" || exit 1

    mv -- "$FOUND" "$TARGET"

    remember_note "$NAME"

    echo
    echo "PASS: Note moved."
    echo
    echo "$CURRENT_MOC → $TARGET_MOC"
    echo "$TARGET"

    notes_git_commit "MOVE" "$OLD_RELATIVE" "$NEW_RELATIVE"
    exit 0
fi

#
# NORMAL OPEN / CREATE
#

if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
    usage
    exit 1
fi

EDITOR_CMD="$1"
MOC="${2:-}"
NAME="${3:-}"

if [ -z "$MOC" ]; then
    MOC="$(choose_moc)"
fi

if [ -z "$MOC" ]; then
    echo
    echo "ERROR: MOC is required."
    exit 1
fi

TARGET_DIR="$(moc_dir "$MOC")"

if [ -z "$TARGET_DIR" ]; then
    echo
    echo "ERROR: Unknown MOC: $MOC"
    exit 1
fi

if [ -z "$NAME" ]; then
    NAME="$(choose_note_name "$TARGET_DIR")"
fi

if [ -z "$NAME" ]; then
    echo
    echo "ERROR: Filename is required."
    exit 1
fi

NAME="$(normalize_note_name "$NAME")"

validate_note_name "$NAME" || exit 1

if ! command -v "$EDITOR_CMD" >/dev/null 2>&1; then
    echo
    echo "ERROR: Editor command not found:"
    echo "$EDITOR_CMD"
    exit 1
fi

run_editor() {
    local file="$1"

    case "$EDITOR_CMD" in
        code|code-insiders|codium)
            "$EDITOR_CMD" --wait "$file"
            ;;
        *)
            "$EDITOR_CMD" "$file"
            ;;
    esac
}

FOUND="$(find_note "$NAME")"

if [ -n "$FOUND" ]; then
    remember_note "$NAME"

    RELATIVE="$(notes_git_relative_path "$FOUND")" || exit 1

    run_editor "$FOUND" || exit $?

    notes_git_commit "EDIT" "$RELATIVE"
    exit 0
fi

cd "$PROJECT" || exit 1

"$BUN" \
    scripts/new-note.ts \
    "$MOC" \
    "$NAME" \
    || exit 1

remember_note "$NAME"

NEW_PATH="$TARGET_DIR/$NAME"
RELATIVE="$(notes_git_relative_path "$NEW_PATH")" || exit 1

run_editor "$NEW_PATH" || exit $?

notes_git_commit "CREATE" "$RELATIVE"
exit 0
