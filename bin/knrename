#!/usr/bin/env bash

ROOT="/home/murat/Media/8-Document/Knowledge"
cd "$ROOT" || exit 1

file="$(
  fd --type f --max-depth 1 --no-ignore --hidden \
    --exclude '.gitignore' \
    --exclude '.git' \
    . |
  sed 's|^\./||' |
  fzf --prompt='Rename > '
)"

[[ -z "$file" ]] && exit 0

# Önce dosyayı AstroNvim'de aç
NVIM_APPNAME=astronvim nvim "$ROOT/$file"

# Neovim'den çıktıktan sonra yeni adı sor
echo
echo "Mevcut dosya: $file"
read -r -p "Yeni dosya adı (uzantı dahil): " newname

[[ -z "$newname" ]] && exit 0
[[ "$newname" == "$file" ]] && exit 0

if [[ -e "$ROOT/$newname" ]]; then
  echo "HATA: '$newname' zaten var."
  exit 1
fi

mv -- "$ROOT/$file" "$ROOT/$newname"

echo
echo "✓ $file -> $newname"
